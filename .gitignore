# MindGraph++ .gitignore
# Research artifacts: track configs/READMEs, ignore large binaries

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
.dmypy.json
dmypy.json

# Flutter / Dart
flutter_app/.dart_tool/
flutter_app/.packages
flutter_app/.pub-cache/
flutter_app/.pub/
flutter_app/build/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.metadata
flutter_app/**/doc/api/
flutter_app/**/*.g.dart
flutter_app/**/*.freezed.dart
flutter_app/**/*.mocks.dart
flutter_app/ios/Pods/
flutter_app/ios/.symlinks/
flutter_app/android/.gradle/
flutter_app/android/app/debug/
flutter_app/android/app/profile/
flutter_app/android/app/release/
flutter_app/android/local.properties
flutter_app/android/key.properties
*.iml
*.ipr
*.iws
.idea/

# Android Studio
.gradle/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# PyCharm
.idea/

# Docker
docker-compose.override.yml

# TensorFlow / PyTorch binaries (track configs, ignore weights)
*.ckpt
*.pt
*.pth
*.onnx
*.tflite
*.pb
*.safetensors
checkpoints/
runs/
lightning_logs/
mlruns/

# Model registry artifacts (keep README/model_card)
models/**/checkpoint.pt
models/**/checkpoint.pth
models/**/exports/
models/**/weights/
models/best/**
models/archive/**
!models/**/README.md
!models/**/model_card.md
!models/**/training_config.yaml
!models/**/metrics.json

# Experiment artifacts (keep YAML/JSON/README, ignore binaries/plots)
experiments/**/checkpoint.pt
experiments/**/checkpoint.pth
experiments/**/exports/
experiments/**/*.png
experiments/**/*.svg
experiments/**/artifacts/
!experiments/**/config.yaml
!experiments/**/hyperparameters.yaml
!experiments/**/metrics.json
!experiments/**/manifest.json
!experiments/**/seeds.json
!experiments/**/README.md
!experiments/**/training.log
!experiments/**/*.csv

# Neo4j local data
neo4j/
data/databases/
data/transactions/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets — NEVER commit
.env
.env.local
.env.staging
.env.production
.env.*.local
*.pem
*.key
secrets/
credentials.json
google-services.json
GoogleService-Info.plist
.env.example
# Logs and runtime
logs/
*.log
backend/logs/
ml_pipeline/logs/
cache/
!cache/.gitkeep

# Datasets (large files — never commit raw media)
datasets/raw/**
datasets/processed/**
datasets/intermediate/**
datasets/cache/**
datasets/downloads/**
!datasets/**/README.md
!datasets/**/.gitkeep
!datasets/metadata/**
!datasets/splits/**/*.json
!datasets/splits/**/*.yaml
!datasets/validation/**/*.json
data/raw/
data/processed/
*.wav
*.mp4
*.avi
*.mov
*.zip
*.tar
*.tar.gz

# ML pipeline outputs
ml_pipeline/weights/**
ml_pipeline/outputs/**
!ml_pipeline/weights/README.md
!ml_pipeline/outputs/README.md

# Research generated outputs (keep structure)
research/**/figures/**
research/**/exports/**
reports/generated/**
reports/daily/**
reports/weekly/**
!reports/**/README.md
!reports/experiment/*.md

# Backups
backups/**
!backups/README.md

# Uploads and exports
uploads/**
exports/**
embeddings/**

# Temporary
tmp/
temp/
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.bak

# Jupyter
.ipynb_checkpoints/
research/notebooks/.ipynb_checkpoints/

# Tools
tools/.cache/

# Frozen lock (optional local)
requirements-frozen.txt
