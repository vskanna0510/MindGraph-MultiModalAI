# MindGraph++ ML Worker
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libsndfile1 \
    ffmpeg \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-prod.txt requirements-ml.txt ./
RUN pip install --upgrade pip && pip install -r requirements-prod.txt && pip install -r requirements-ml.txt

COPY backend/ ./backend/
COPY ml_pipeline/ ./ml_pipeline/
COPY configs/ ./configs/

CMD ["python", "-m", "ml_pipeline.workers.inference_worker"]
